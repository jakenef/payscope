OPENAI_API_KEY=sk-...your-key-here...
# Optional fallback: used if OPENAI_API_KEY is missing or its requests fail.
OPENROUTER_API_KEY=sk-or-...your-key-here...

# Admin · NPI import (/api/admin/npi/import) — match emails in frontend/src/admin/config.js
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...   # same project anon key as VITE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only; never expose to the browser
ADMIN_EMAILS=maxp68034@gmail.com

# Cron (Render): POST /api/admin/voice/tick with header X-Admin-Key
ADMIN_CRON_SECRET=generate-a-long-random-string

# Lob intro letters (https://dashboard.lob.com) — verify sender address + HTML letter template
LOB_API_KEY=
LOB_FROM_ADDRESS_ID=adr_...
LOB_LETTER_TEMPLATE_ID=tmpl_...
LOB_WEBHOOK_SECRET=
PAYSCOPE_DEMO_URL=https://payscope-two.vercel.app

# Twilio + ElevenLabs voice (PUBLIC_API_BASE = this FastAPI deployment, e.g. Render URL)
PUBLIC_API_BASE=https://payscope-jgoa.onrender.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
# Paste the WebSocket URL from ElevenLabs Conversational AI → Twilio integration
ELEVENLABS_TWILIO_STREAM_URL=wss://...
VOICE_FOLLOWUP_DELAY_DAYS=8
